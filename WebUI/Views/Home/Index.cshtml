@model WebUI.Models.DashboardViewModel
<div class="dashboard-container">
    <div class="dashboard-header">
        <h2>🏠 Панель управления</h2>
        <p>Быстрый доступ к разделам системы</p>
    </div>

    @if (Model.LowStockCount > 0)
    {
        <div class="alert alert-warning mb-4">
            ⚠ Внимание! Товаров с низким остатком: <strong>@Model.LowStockCount</strong>
        </div>
    }
    else
    {
        <div class="alert alert-success mb-4">
            ✅ Критически низких остатков нет
        </div>
    }

    <div class="row g-4">

        <div class="row g-4 mb-4">
            <div class="col-md-12">
                <a asp-controller="Dashboard" asp-action="Index" class="dashboard-link">
                    <div class="dashboard-card card-analytics" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                        <div class="card-icon">📊</div>
                        <div class="card-title">Аналитический дашборд</div>
                        <div class="card-desc">Подробная статистика и графики</div>
                    </div>
                </a>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <a asp-controller="Products" asp-action="Index" class="dashboard-link">
                <div class="dashboard-card card-products">
                    <div class="card-icon">📦</div>
                    <div class="card-title">Товары</div>
                    <div class="card-desc">Управление товарами</div>
                </div>
            </a>
        </div>

        <div class="col-md-3 col-sm-6">
            <a asp-controller="Suppliers" asp-action="Index" class="dashboard-link">
                <div class="dashboard-card card-suppliers">
                    <div class="card-icon">🚚</div>
                    <div class="card-title">Поставщики</div>
                    <div class="card-desc">Список поставщиков</div>
                </div>
            </a>
        </div>

        <div class="col-md-3 col-sm-6">
            <a asp-controller="Orders" asp-action="Index" class="dashboard-link">
                <div class="dashboard-card card-orders">
                    <div class="card-icon">🧾</div>
                    <div class="card-title">Заказы</div>
                    <div class="card-desc">Все заказы</div>
                </div>
            </a>
        </div>

        <div class="col-md-3 col-sm-6">
            <a asp-controller="Stock" asp-action="Index" class="dashboard-link">
                <div class="dashboard-card card-stock">
                    <div class="card-icon">🏬</div>
                    <div class="card-title">Остатки</div>
                    <div class="card-desc">Складские остатки</div>
                </div>
            </a>
        </div>
    </div>
</div>