@model List<WebUI.Models.Order>

<h2>Заказы</h2>

<table border="1">
    <tr>
        <th>ID</th>
        <th>Номер заказа</th>
        <th>Дата</th>
        <th>Статус</th>
        <th>Количество</th>
    </tr>

@foreach (var item in Model)
{
    <tr>
        <td>@item.Id</td>
        <td>@item.OrderNumber</td>
        <td>@item.Date</td>
        <td>@item.Status</td>
        <td>@item.Quantity</td>
    </tr>
}
</table>
