@model List<WebUI.Models.StockItem>

@{
    ViewData["Title"] = "Остатки на складе";
}

<div class="stocks-page">
    <div class="page-header">
        <h2>🏭 Остатки на складе</h2>
        <p class="text-muted">Текущее количество товаров на складе</p>
    </div>

    <div class="table-responsive">
        <table class="stocks-table">
            <thead>
                <tr>
                    <th>ID товара</th>
                    <th>Название</th>
                    <th>Количество (ед.)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="stock-row">
                        <td class="stock-id">@item.Id</td>
                        <td class="stock-name">@item.ProductName</td>
                        <td class="stock-quantity">
                            <span class="stock-badge @(item.Quantity <= 0 ? "zero-stock" : item.Quantity < 10 ? "low-stock" : "normal-stock")">
                                @item.Quantity
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
    </div>
</div>