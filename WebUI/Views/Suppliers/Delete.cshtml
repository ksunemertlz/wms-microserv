@model WebUI.Models.SupplierViewModel

@{
    ViewData["Title"] = "Удаление поставщика";
}

<div class="container mt-4">
    <div class="card border-danger">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">⚠️ Подтверждение удаления</h3>
        </div>
        <div class="card-body">
            <p class="fs-5">Вы уверены, что хотите удалить поставщика <strong>@Model.Name</strong>?</p>
            <p class="text-muted">Это действие нельзя отменить.</p>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">🗑️ Удалить</button>
                <a asp-action="Index" class="btn btn-secondary">Отмена</a>
            </form>
        </div>
    </div>
</div>