@model List<WebUI.Models.Product>

<h2>Товары поставщика</h2>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Название</th>
            <th>SKU</th>
            <th>Количество</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Sku</td>
                <td>@item.Quantity</td>
            </tr>
        }
    </tbody>
</table>

<div style="margin-top: 20px;">
    <a asp-action="Index" class="btn btn-secondary">← Назад к списку поставщиков</a>
</div>